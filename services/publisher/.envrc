# Set GOWORK to use publisher-specific workspace.
# go.work is gitignored (generated by `task bootstrap`). Only export GOWORK when
# it actually exists — an unconditional export points Go/gopls at a missing
# workspace file, which breaks builds and LSP. When absent, fall back to module
# mode (the committed go.mod replaces cover local deps).
if [ -f "$(pwd)/go.work" ]; then
  export GOWORK="$(pwd)/go.work"
fi
