services/
├─ go.work                      # local-only; lists all modules for nice IDE UX
├─ tools/                       # pinned tool deps (golangci-lint, buf, mage, etc.)
│  └─ tools.go
├─ libs/                        # shared modules (avoid premature sharing)
│  ├─ authkit/                  # module: shared auth/JWT, small and cohesive
│  │  ├─ go.mod
│  │  └─ ...
│  └─ sdk/                      # module: client SDKs / API wrappers
│     ├─ go.mod
│     └─ ...
├─ proto/                       # (optional) shared protobuf/IDLs
│  ├─ buf.yaml / buf.gen.yaml
│  └─ api/...
├─ ranger/                  # service = 1 module = 1 container = 1 chart
│  ├─ go.mod
│  ├─ cmd/ranger/               # main
│  │  └─ main.go
│  ├─ internal/                 # service-internal pkgs (not for reuse)
│  ├─ pkg/                      # exported service SDK (rare; prefer libs/sdk)
│  ├─ api/                      # openapi/proto for this service
│  ├─ configs/                  # dev configs (prod via Helm values)
│  ├─ Dockerfile
│  └─ deploy/
│     ├─ helm/                  # chart for this service (consumed by Flux)
│     │  ├─ Chart.yaml
│     │  ├─ values.yaml
│     │  └─ templates/...
│     └─ kustomize/             # optional overlay for local/kind
└─ sharder/
   ├─ go.mod
   ├─ cmd/sharder-controller/   # your controller-runtime operator
   ├─ config/                   # CRDs/RBAC; kustomize base (kubebuilder style)
   └─ deploy/helm/              # optional Helm wrapper for Flux

ops/                             # (optional) scripts, supply chain (sbom/signing)
└─ ci/
   ├─ docker/                    # common dockerfiles/fragments
   └─ gha/                       # GH Actions templates
