# Ranger Service Secrets
# Copy this file to .secret.env.ranger and fill in your values
# IMPORTANT: .secret.env.ranger is gitignored - never commit actual secrets

RANGER_QUEUE_URL="https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/queues/YOUR_QUEUE_NAME"
RANGER_QUEUE_API_TOKEN="your-cloudflare-queue-api-token"
