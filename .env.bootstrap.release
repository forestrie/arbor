# CI-only overlay selected via ENV_SCOPE=.bootstrap.release by
# `task bootstrap:release` (FOR-568 O1). Not used by plain `task bootstrap`.
# Pins go-merklelog to GO_MERKLELOG_PIN (set in Taskfile.dist.yml); the
# ordinary .env.bootstrap's GIT_CLONES already cloned it, this only moves
# the checkout.
export GIT_CHECKOUTS="\
https://github.com/forestrie/go-merklelog.git#./services/_deps/go-merklelog^${GO_MERKLELOG_PIN}
"
